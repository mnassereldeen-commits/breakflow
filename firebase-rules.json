// BreakFlow - Realtime Database security rules.
//
// Paste the whole file into: Firebase Console -> Realtime Database -> Rules -> Publish.
// The console accepts these // comments.
//
// The short version:
//   * Accounts are created by a supervisor. Nobody can sign themselves
//     up: an account with no agent record can't read or write anything.
//   * You may create and change YOUR OWN break, and nobody else's.
//   * You cannot delete or rewrite a break that has already closed,
//     so an overstay can't be erased after the fact.
//   * Admins are decided by login name, in /breakflow/admins. There is
//     no way for an agent to promote themselves - nothing in their own
//     record grants anything.
//   * Admins can do all of it.
//
// The admin list is { "login,with,dots,as,commas": true }. The first
// account created claims the board; after that only an existing admin
// can change the list.

{
  "rules": {
    "breakflow": {

      // Only people with an agent record, plus listed admins. An
      // account created straight against Firebase Auth gets nothing.
      ".read": "auth != null && (root.child('breakflow/agents').child(auth.uid).exists() || root.child('breakflow/admins').child(auth.token.email.lower().replace('.', ',')).val() == true)",

      // Public: lets the sign-in page know whether to offer first-run
      // setup. One boolean, nothing else is readable without an account.
      "setupDone": {
        ".read": true,
        ".write": "root.child('breakflow/admins').child(auth.token.email.lower().replace('.', ',')).val() == true || !root.child('breakflow/admins').exists()",
        ".validate": "newData.isBoolean()"
      },

      // WHO IS AN ADMIN. Writable by an existing admin, or by the very
      // first account while the list is still empty.
      "admins": {
        ".write": "root.child('breakflow/admins').child(auth.token.email.lower().replace('.', ',')).val() == true || !root.child('breakflow/admins').exists()",
        "$emailKey": { ".validate": "newData.isBoolean()" }
      },

      // Floor policy: admins only (open once, for first-run setup).
      "settings": {
        ".write": "root.child('breakflow/admins').child(auth.token.email.lower().replace('.', ',')).val() == true || root.child('breakflow/settings/hasAdmin').val() != true"
      },

      // Break policies: admins only.
      "breakTypes": {
        ".write": "root.child('breakflow/admins').child(auth.token.email.lower().replace('.', ',')).val() == true"
      },

      "agents": {
        "$uid": {
          // Admins create and edit anyone. You may edit your OWN record
          // but not create it - so nobody can enrol themselves. The one
          // exception is the very first account, which claims the board.
          ".write": "root.child('breakflow/admins').child(auth.token.email.lower().replace('.', ',')).val() == true || ($uid == auth.uid && data.exists()) || ($uid == auth.uid && !root.child('breakflow/admins').exists())",

          "uid": { ".validate": "newData.val() == $uid" },
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
          "email": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "team": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "lastSeen": { ".validate": "newData.isNumber()" }
        }
      },

      "sessions": {
        "$sid": {
          // THE IMPORTANT ONE.
          // create : only a break whose agentId is you
          // change : only your own, and only while it is still open
          // delete : never (admins only)
          ".write": "root.child('breakflow/admins').child(auth.token.email.lower().replace('.', ',')).val() == true || (!data.exists() && newData.child('agentId').val() == auth.uid) || (data.exists() && newData.exists() && data.child('agentId').val() == auth.uid && newData.child('agentId').val() == auth.uid && data.child('state').val() != 'done' && data.child('state').val() != 'cancelled' && data.child('state').val() != 'denied')",

          "agentId": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "agentName": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "state": { ".validate": "newData.val().matches(/^(queued|active|over|done|cancelled|denied)$/)" },
          "minutes": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 60" },
          "breakTypeId": { ".validate": "newData.isString() && newData.val().length <= 40" }
        }
      }
    },

    // Nothing outside /breakflow is reachable.
    "$everythingElse": { ".read": false, ".write": false }
  }
}
